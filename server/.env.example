// Environment Variables Template for Server
// Copy this file to .env and fill in your actual values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/flowers-shop

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=your-secret-key-change-this-in-production

# Email Configuration (Gmail Example)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@flowersshop.bd

# Stripe Payment Gateway
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key

# bKash Payment Gateway (Bangladesh)
BKASH_API_KEY=your_bkash_api_key
BKASH_SECRET_KEY=your_bkash_secret_key
BKASH_APP_KEY=your_bkash_app_key

# Client URL
CLIENT_URL=http://localhost:3000

# File Upload Directory
UPLOAD_DIR=uploads/

# Node Environment
NODE_ENV=development
